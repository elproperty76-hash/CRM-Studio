rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Aturan terisolasi per pengguna: setiap pengguna hanya dapat mengakses datanya sendiri
    match /users/{userId}/customers/{customerId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /users/{userId}/leads/{leadId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Kompatibilitas koleksi legacy agar migrasi berjalan mulus untuk pengguna terautentikasi
    match /customers/{customerId} {
      allow read, write: if request.auth != null;
    }
    
    match /leads/{leadId} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
